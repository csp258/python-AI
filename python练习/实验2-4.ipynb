   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "customer_ids = np.array([1001, 1002, 1003, 1001, 1004, 1002, 1005])\n",
    "\n",
    "\n",
    "unique_ids = np.unique(customer_ids)\n",
    "\n",
    "unique_count = len(unique_ids)\n",
    "\n",
    "\n",
    "\n",
    "print(\"原始客户ID数组：\")\n",
    "print(customer_ids)\n",
    "print(\"\\n（2）所有唯一客户ID：\")\n",
    "print(unique_ids)\n",
    "print(f\"\\n（3）唯一客户数量：{unique_count}\")"
   ]
  }
 ],
